# GPT-image-2 drawing site configuration
#
# Docker:   copy this file's values into a .env file next to docker-compose.yml
#           (the compose file reads IMAGE_SITE_* from there).
# systemd:  deploy/install.sh installs these values to /etc/m365-image-site.env.

# Gateway API key used for server-side /v1/images/* calls.
# Create one in the gateway web console (API Keys page). The key is NEVER
# exposed to the browser — it only lives in this server-side file.
IMAGE_SITE_API_KEY=m365_replace_me

# Session cookie signing secret, MUST be at least 32 bytes.
# Generate with:  openssl rand -hex 32
IMAGE_SITE_SESSION_SECRET=

# One-time bootstrap admin for the drawing site itself (independent accounts,
# password stored only as a PBKDF2 hash). Fill both, complete the first login,
# then delete both lines.
IMAGE_SITE_INITIAL_USERNAME=
IMAGE_SITE_INITIAL_PASSWORD=
